{
  "schema": "graph_cli.model/1",
  "graph": {
    "name": "example_graph",
    "language": "en"
  },
  "ontology": {
    "bundle": "inventory",
    "version": "1.0.0"
  },
  "module": {
    "id": "inventory",
    "prefix": "inv",
    "version": "1.0.0",
    "summary": "Physical items, where they are stored and how they are grouped.",
    "builtin": false,
    "types": [
      {
        "curie": "inv:Item",
        "abstract": false,
        "extends": null,
        "summary": "A physical thing that is tracked.",
        "deprecated": false
      }
    ],
    "relations": [
      {
        "curie": "inv:part_of",
        "domain": [
          "inv:Item"
        ],
        "range": [
          "inv:Item"
        ],
        "cardinality": {
          "out": "0..1",
          "in": "0..n"
        },
        "summary": "The item is a component of a larger item.",
        "deprecated": false
      }
    ],
    "links_out": [],
    "links_in": [],
    "rules": [
      {
        "id": "inv.serial_single_unit",
        "severity": "error",
        "summary": "Serialized items have quantity 1.",
        "deprecated": false
      }
    ],
    "functions": [
      {
        "name": "items_by_condition",
        "summary": "Items in a given physical condition.",
        "signature": "condition: enum inv:Condition"
      },
      {
        "name": "named_by_quantity",
        "summary": "Names of the things held in a larger number.",
        "signature": "limit: integer"
      }
    ],
    "actions": [
      {
        "name": "retire_item",
        "summary": "Take an item out of service for good.",
        "signature": "item: ref inv:Item"
      }
    ]
  }
}
