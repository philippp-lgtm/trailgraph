  "action": {
    "name": "retire_item",
    "module": "inventory",
    "summary": "Take an item out of service for good.",
    "use_when": "An item is scrapped, written off or taken out of service.",
    "status": "active",
    "replaced_by": null,
    "featured": false,
    "reason": "required",
    "signature": "item: ref inv:Item",
    "params": [
      {
        "name": "item",
        "type": "ref",
        "class": "inv:Item",
        "enum": null,
        "many": false,
        "default": null,
        "summary": "The item to retire."
      }
    ],
    "preconditions": [
      {
        "id": "not_retired",
        "on": "item",
        "summary": "The item is still in the inventory.",
        "expr": {
          "in": [
            {
              "attr": "status"
            },
            {
              "const": [
                "ordered",
                "in_stock",
                "in_use"
              ]
            }
          ]
        }
      }
    ],
    "examples": [
