{
  "schema": "graph_cli.model/1",
  "graph": {
    "name": "example_graph",
    "language": "en"
  },
  "ontology": {
    "bundle": "company",
    "version": "1.1.0"
  },
  "action": {
    "name": "hand_over_position",
    "module": "organization",
    "summary": "Replace the current holder of a position by another person, from a date.",
    "use_when": "A position that somebody holds gets a new holder: succession, a swap, a handover. Not for staffing a vacant position: use assign_position.",
    "status": "active",
    "replaced_by": null,
    "featured": true,
    "reason": "optional",
    "signature": "position: ref org:Position, person: ref ppl:Person, since?: date",
    "params": [
      {
        "name": "position",
        "type": "ref",
        "class": "org:Position",
        "enum": null,
        "many": false,
        "default": null,
        "summary": "The position that changes hands."
      },
      {
        "name": "person",
        "type": "ref",
        "class": "ppl:Person",
        "enum": null,
        "many": false,
        "default": null,
        "summary": "The new holder."
      },
      {
        "name": "since",
        "type": "date",
        "class": null,
        "enum": null,
        "many": false,
        "default": null,
        "summary": "Date the new holder takes over.",
        "optional": true
      }
    ],
    "preconditions": [
      {
        "id": "position_held",
        "on": "position",
        "summary": "Somebody holds the position; use assign_position for a vacant one.",
        "expr": {
          "ge": [
            {
              "count": {
                "rel": "org:holds",
                "direction": "in",
                "where": {
                  "record_status": [
                    "active"
                  ]
                }
              }
            },
            {
              "const": 1
            }
          ]
        }
      }
    ],
    "examples": [
      {
        "request": "The head of the support team hands the lead position over to a colleague."
      }
    ],
    "ops": [
      {
        "op": "unlink",
        "id": "$position",
        "rel": "org:holds",
        "direction": "in",
        "all": true
      },
      {
        "op": "link",
        "id": "$person",
        "rel": "org:holds",
        "target": "$position",
        "qualifiers": {
          "since": "$since"
        }
      }
    ],
    "touches": {
      "types": [
        {
          "curie": "org:Position",
          "module": "organization"
        },
        {
          "curie": "ppl:Person",
          "module": "people"
        }
      ],
      "relations": [
        {
          "curie": "org:holds",
          "module": "organization"
        }
      ]
    },
    "needs": [
      {
        "action": "write.link",
        "type": "ppl:Person"
      },
      {
        "action": "write.unlink",
        "type": "ppl:Person"
      }
    ],
    "hash": "sha256:f3d5a5b3c287274b2bc60192bdf7d18c7b335b235ae4b2b459234dd99a1ebbd4"
  }
}
