  "rules": [
    {
      "annotations": {},
      "deprecated": false,
      "description": null,
      "expr": {
        "ge": [
          {
            "count": {
              "direction": "in",
              "rel": "nas:cites"
            }
          },
          {
            "const": 1
          }
        ]
      },
      "id": "nas.source_cited",
      "severity": "warning",
      "summary": "Every source is cited by at least one note.",
      "target": "nas:Source",
      "when": "batch"
    },
    {
      "annotations": {},
      "deprecated": false,
      "description": null,
      "expr": {
        "implies": [
          {
            "and": [
              {
                "eq": [
                  {
                    "attr": "status"
                  },
                  {
                    "const": "published"
                  }
                ]
              },
              {
                "eq": [
                  {
                    "attr": "kind"
                  },
                  {
                    "const": "summary"
                  }
                ]
              }
            ]
          },
          {
            "ge": [
              {
                "count": {
                  "direction": "out",
                  "rel": "nas:cites"
                }
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "id": "nas.summary_cites_source",
      "severity": "error",
      "summary": "A published summary note cites at least one source.",
      "target": "nas:Note",
      "when": "write"
    },
    {
      "annotations": {},
      "deprecated": false,
      "description": null,
      "expr": {
        "or": [
          {
            "ge": [
              {
                "count": {
                  "direction": "in",
                  "rel": "nas:about"
                }
              },
              {
                "const": 1
              }
            ]
          },
          {
            "ge": [
              {
                "count": {
                  "direction": "in",
                  "rel": "nas:broader"
                }
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "id": "nas.topic_not_orphan",
      "severity": "warning",
      "summary": "A topic has notes or narrower topics.",
      "target": "nas:Topic",
      "when": "batch"
    }
  ],
