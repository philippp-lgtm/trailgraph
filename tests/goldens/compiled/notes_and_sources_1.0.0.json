    },
    "provenance:Confidence": {
      "annotations": {},
      "deprecated": false,
      "description": null,
      "summary": "How strongly a claim is believed.",
      "values": [
        {
          "name": "low",
          "summary": "Plausible but weakly supported."
        },
        {
          "name": "medium",
          "summary": "Supported by some evidence."
        },
        {
          "name": "high",
          "summary": "Supported by strong evidence."
        }
      ]
    }
  },
  "lifecycles": {
    "nas:NoteLifecycle": {
      "annotations": {},
      "deprecated": false,
      "description": null,
      "initial": [
        "draft"
      ],
      "states": [
        {
          "name": "draft",
          "summary": "Being written."
        },
        {
          "name": "published",
          "summary": "Visible and citable."
        },
        {
          "name": "archived",
          "summary": "Kept for history only."
        }
      ],
      "summary": "Editorial state of a note.",
      "terminal": [
        "archived"
      ],
      "transitions": [
        {
          "from": "draft",
          "guards": [
            {
              "expr": {
                "nonempty": {
                  "attr": "body"
                }
              },
              "id": "nas.body_not_empty",
              "summary": "A note needs a body before it is published."
            }
          ],
          "summary": "Publish the note.",
          "to": "published"
        },
        {
          "from": "published",
          "guards": [],
          "summary": "Take the note back for editing.",
          "to": "draft"
        },
        {
          "from": "draft",
          "guards": [],
          "summary": "Archive the note.",
          "to": "archived"
        },
        {
          "from": "published",
          "guards": [],
          "summary": "Archive the note.",
          "to": "archived"
        }
      ]
    }
  },
