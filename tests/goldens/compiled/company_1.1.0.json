  "lifecycles": {
    "org:PositionLifecycle": {
      "annotations": {},
      "deprecated": false,
      "description": null,
      "initial": [
        "planned"
      ],
      "states": [
        {
          "name": "planned",
          "summary": "Approved on paper but not yet part of the working structure."
        },
        {
          "name": "active",
          "summary": "Part of the working structure and may be held."
        },
        {
          "name": "abolished",
          "summary": "Removed from the structure for good."
        }
      ],
      "summary": "How far a position has come in the org chart.",
      "terminal": [
        "abolished"
      ],
      "transitions": [
        {
          "from": "planned",
          "guards": [
            {
              "expr": {
                "eq": [
                  {
                    "count": {
                      "direction": "out",
                      "rel": "org:in_unit"
                    }
                  },
                  {
                    "const": 1
                  }
                ]
              },
              "id": "org.has_unit",
              "summary": "An active position belongs to a unit."
            }
          ],
          "summary": "Open the position.",
          "to": "active"
        },
        {
          "from": "planned",
          "guards": [
            {
              "expr": {
                "eq": [
                  {
                    "count": {
                      "direction": "in",
                      "rel": "org:holds",
                      "where": {
                        "record_status": [
                          "active"
                        ]
                      }
                    }
                  },
                  {
                    "const": 0
                  }
                ]
              },
              "id": "org.not_held",
              "summary": "A position that is held by a person cannot be abolished."
            }
          ],
          "summary": "Remove the position from the structure.",
          "to": "abolished"
        },
        {
          "from": "active",
          "guards": [
            {
              "expr": {
                "eq": [
                  {
                    "count": {
                      "direction": "in",
                      "rel": "org:holds",
                      "where": {
                        "record_status": [
                          "active"
                        ]
                      }
                    }
                  },
                  {
                    "const": 0
                  }
                ]
              },
              "id": "org.not_held",
              "summary": "A position that is held by a person cannot be abolished."
            }
          ],
          "summary": "Remove the position from the structure.",
          "to": "abolished"
        }
      ]
    }
  },
