          "name": "new",
          "summary": "Unused."
        },
        {
          "name": "good",
          "summary": "Used, fully functional."
        },
        {
          "name": "worn",
          "summary": "Visible wear, still functional."
        },
        {
          "name": "damaged",
          "summary": "Not safe or not able to be used."
        }
      ]
    }
  },
  "lifecycles": {
    "inv:ItemLifecycle": {
      "annotations": {},
      "deprecated": false,
      "description": null,
      "initial": [
        "ordered"
      ],
      "states": [
        {
          "name": "ordered",
          "summary": "Bought but not received."
        },
        {
          "name": "in_stock",
          "summary": "Received and available."
        },
        {
          "name": "in_use",
          "summary": "Handed out and in use."
        },
        {
          "name": "retired",
          "summary": "Out of service for good."
        }
      ],
      "summary": "Availability of an item.",
      "terminal": [
        "retired"
      ],
      "transitions": [
        {
          "from": "ordered",
          "guards": [],
          "summary": "Receive the item.",
          "to": "in_stock"
        },
        {
          "from": "in_stock",
          "guards": [
            {
              "expr": {
                "not": {
                  "eq": [
                    {
                      "attr": "condition"
                    },
                    {
                      "const": "damaged"
                    }
                  ]
                }
              },
              "id": "inv.usable",
              "summary": "Damaged items cannot be used."
            }
          ],
          "summary": "Hand the item out.",
          "to": "in_use"
        },
        {
          "from": "in_use",
          "guards": [],
          "summary": "Return the item.",
          "to": "in_stock"
        },
        {
          "from": "ordered",
          "guards": [
            {
              "expr": {
                "eq": [
                  {
                    "count": {
                      "direction": "in",
                      "rel": "inv:part_of",
                      "where": {
                        "record_status": [
                          "active"
                        ]
                      }
                    }
                  },
                  {
                    "const": 0
                  }
                ]
              },
              "id": "inv.no_active_parts",
              "summary": "An item with active parts cannot be retired."
            }
          ],
          "summary": "Take the item out of service.",
          "to": "retired"
        },
        {
          "from": "in_stock",
          "guards": [
            {
              "expr": {
                "eq": [
                  {
                    "count": {
                      "direction": "in",
                      "rel": "inv:part_of",
                      "where": {
                        "record_status": [
                          "active"
                        ]
                      }
                    }
                  },
                  {
                    "const": 0
                  }
                ]
              },
              "id": "inv.no_active_parts",
              "summary": "An item with active parts cannot be retired."
            }
          ],
          "summary": "Take the item out of service.",
          "to": "retired"
        },
        {
          "from": "in_use",
          "guards": [
            {
              "expr": {
                "eq": [
                  {
                    "count": {
                      "direction": "in",
                      "rel": "inv:part_of",
                      "where": {
                        "record_status": [
                          "active"
                        ]
                      }
                    }
                  },
                  {
                    "const": 0
                  }
                ]
              },
              "id": "inv.no_active_parts",
              "summary": "An item with active parts cannot be retired."
            }
          ],
          "summary": "Take the item out of service.",
          "to": "retired"
        }
      ]
    }
