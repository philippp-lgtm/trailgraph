  "lifecycles": {
    "stf:OnboardingFlow": {
      "annotations": {},
      "deprecated": false,
      "description": null,
      "initial": [
        "started"
      ],
      "states": [
        {
          "name": "started",
          "summary": "Onboarding started."
        },
        {
          "name": "equipped",
          "summary": "Has what the work needs."
        },
        {
          "name": "scheduled",
          "summary": "Has a shift."
        }
      ],
      "summary": "Onboarding of an employee.",
      "terminal": [],
      "transitions": [
        {
          "from": "started",
          "guards": [
            {
              "expr": {
                "exists": {
                  "attr": "badge_code"
                }
              },
              "id": "stf.badge_known",
              "summary": "The badge code is recorded."
            }
          ],
          "summary": "Hand out the badge.",
          "to": "equipped"
        },
        {
          "from": "started",
          "guards": [
            {
              "expr": {
                "exists": {
                  "attr": "shift"
                }
              },
              "id": "stf.shift_known",
              "summary": "The shift is recorded."
            }
          ],
          "summary": "Plan the shift.",
          "to": "scheduled"
        }
      ]
    }
  },
