    {
      "path": [
        "find"
      ],
      "kind": "read",
      "surface": "retrieve",
      "action": "read.find",
      "summary": "Find entities by type, field filters and relations; paged.",
      "args": [],
      "options": [
        {
          "name": "--type",
          "type": "term",
          "required": false,
          "repeatable": true,
          "summary": "Type CURIE, subtypes included."
        },
        {
          "name": "--where",
          "type": "filter",
          "required": false,
          "repeatable": true,
          "summary": "attr=value or attr:op=value (ne lt le gt ge contains prefix in exists)."
        },
        {
          "name": "--rel",
          "type": "string",
          "required": false,
          "repeatable": true,
          "summary": "Outgoing relation, optionally =<id>."
        },
        {
          "name": "--in-rel",
          "type": "string",
          "required": false,
          "repeatable": true,
          "summary": "Incoming relation, optionally =<id>."
        },
        {
          "name": "--include-inactive",
          "type": "flag",
          "required": false,
          "repeatable": false,
          "summary": "Include superseded and retracted entities."
        },
        {
          "name": "--sort",
          "type": "string",
          "required": false,
          "repeatable": true,
          "summary": "Field to sort by, optionally :desc."
        },
        {
          "name": "--limit",
          "type": "integer",
          "required": false,
          "repeatable": false,
          "summary": "Page size, at most 500.",
          "default": 50
        },
        {
          "name": "--offset",
          "type": "integer",
          "required": false,
          "repeatable": false,
          "summary": "Skip this many results.",
          "default": 0
        },
        {
          "name": "--graph",
          "type": "graph_ref",
          "required": false,
          "repeatable": false,
          "summary": "Graph name or id; else GRAPH_CLI_GRAPH or the pointer default."
        },
        {
          "name": "--as-of",
          "type": "string",
          "required": false,
          "repeatable": false,
          "summary": "Read an earlier state (tx:<seq>); reserved."
        }
      ],
      "examples": [
        {
          "command": "graph find --type <type> --where <attr>=<value>",
          "summary": "Filter by a field."
        },
        {
          "command": "graph find --type <type> --rel <relation>=<id> --json",
          "summary": "Filter by a relation."
        }
      ],
