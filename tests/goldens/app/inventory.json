        },
        {
          "name": "--direction",
          "type": "choice",
          "required": false,
          "repeatable": false,
          "summary": "Edge direction.",
          "choices": [
            "out",
            "in",
            "both"
          ],
          "default": "both"
        },
        {
          "name": "--depth",
          "type": "integer",
          "required": false,
          "repeatable": false,
