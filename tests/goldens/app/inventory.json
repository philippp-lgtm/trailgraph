      ],
      "kind": "write",
      "surface": "act",
      "action": "write.create",
      "summary": "Create one entity of a type.",
      "args": [
        {
          "name": "type",
          "type": "term",
          "required": true,
          "repeatable": false,
          "summary": "Type CURIE."
        }
      ],
      "options": [
        {
          "name": "--set",
          "type": "assignment",
          "required": false,
          "repeatable": true,
          "summary": "attr=value, coerced by the attribute's datatype."
        },
        {
          "name": "--set-json",
          "type": "json_assignment",
          "required": false,
          "repeatable": true,
          "summary": "attr=<json>, a typed value."
        },
        {
          "name": "--edge",
          "type": "assignment",
          "required": false,
          "repeatable": true,
          "summary": "relation=<id>: an outgoing edge."
        },
        {
          "name": "--valid-from",
          "type": "string",
          "required": false,
          "repeatable": false,
          "summary": "Start of validity: date or RFC 3339 timestamp."
        },
        {
          "name": "--valid-to",
          "type": "string",
          "required": false,
          "repeatable": false,
          "summary": "End of validity: date or RFC 3339 timestamp."
        },
        {
          "name": "--graph",
          "type": "graph_ref",
          "required": false,
          "repeatable": false,
          "summary": "Graph name or id; else GRAPH_CLI_GRAPH or the pointer default."
        },
        {
          "name": "--dry-run",
          "type": "flag",
          "required": false,
          "repeatable": false,
          "summary": "Validate and show the result without writing."
        },
        {
          "name": "--reason",
          "type": "string",
          "required": false,
          "repeatable": false,
          "summary": "Why this change is made (required for supersede, retract)."
        },
        {
          "name": "--idempotency-key",
          "type": "string",
          "required": false,
          "repeatable": false,
          "summary": "Key that makes a retry safe."
        }
      ],
      "examples": [
        {
          "command": "graph create <type> --set <attr>=<value>",
          "summary": "Create with one attribute."
        },
        {
          "command": "graph create <type> --set <attr>=<value> --edge <relation>=<id> --dry-run --json",
