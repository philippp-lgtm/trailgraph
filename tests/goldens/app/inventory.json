      "surface": "act",
      "action": null,
      "summary": "Apply change set documents (JSON or JSONL) from a file or stdin.",
      "args": [
        {
          "name": "file",
          "type": "file",
          "required": true,
          "repeatable": false,
          "summary": "Path of the input, or - for stdin."
        }
      ],
      "options": [
        {
          "name": "--graph",
          "type": "graph_ref",
          "required": false,
          "repeatable": false,
          "summary": "Graph name or id; else GRAPH_CLI_GRAPH or the pointer default."
        },
        {
          "name": "--dry-run",
          "type": "flag",
          "required": false,
          "repeatable": false,
          "summary": "Validate every document without writing."
        },
        {
          "name": "--idempotency-key",
          "type": "string",
          "required": false,
          "repeatable": false,
          "summary": "Key that makes a retry safe; single document only, else idempotency_key in each document."
        }
      ],
      "examples": [
        {
          "command": "graph apply - --json",
          "summary": "Apply documents from stdin."
