    {
      "name": "do_set_phone",
      "kind": "action",
      "entry": "set_phone",
      "description": "Set phone of an employee.\n\nUse when: Set phone of an employee.\n\nExamples:\n- Set phone of an employee.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "who": {
            "type": "string",
            "pattern": "^(?:(?:urn:uuid:)?[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|[A-Z][A-Z0-9]{0,7}-[0-9]{4,}|[0-9a-fA-F]{8,32})$",
            "x-graph-cli": {
              "class": "stf:Employee"
            },
            "description": "The employee. An entity of class stf:Employee: its id, its alias or 8 to 32 trailing hex digits of its id; a name has to be looked up first."
          },
          "value": {
            "type": "string",
            "description": "A value."
          },
          "_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "description": "Why this change is made; recorded in the audit trail."
          },
          "_dry_run": {
            "type": "boolean",
            "description": "Check the preconditions and report what would change; nothing is written.",
            "default": false
          }
        },
        "required": [
          "who",
          "value"
        ]
      },
