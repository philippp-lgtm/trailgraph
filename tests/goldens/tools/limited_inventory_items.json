    {
      "name": "do_retire_item",
      "kind": "action",
      "entry": "retire_item",
      "description": "Take an item out of service for good.\n\nUse when: An item is scrapped, written off or taken out of service.\n\nExamples:\n- The old label printer is scrapped.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "pattern": "^(?:(?:urn:uuid:)?[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|[A-Z][A-Z0-9]{0,7}-[0-9]{4,}|[0-9a-fA-F]{8,32})$",
            "x-graph-cli": {
              "class": "inv:Item"
            },
            "description": "The item to retire. An entity of class inv:Item: its id, its alias or 8 to 32 trailing hex digits of its id; a name has to be looked up first."
          },
          "_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S",
            "description": "Why this change is made; recorded in the audit trail. Required for this action."
          },
          "_dry_run": {
            "type": "boolean",
            "description": "Check the preconditions and report what would change; nothing is written.",
            "default": false
          }
        },
        "required": [
          "item",
          "_reason"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "tx_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "dry_run": {
            "type": "boolean"
          },
          "idempotent_replay": {
            "type": "boolean"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "entity_count": {
            "type": "integer"
          },
          "entities": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "alias": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "rev": {
                      "type": "integer"
                    },
                    "type": {
                      "type": "string"
                    },
                    "ops": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "local": {
