                "code": {
                  "type": "string"
                },
                "target": {
                  "type": "object",
                  "additionalProperties": true
                },
                "message": {
                  "type": "string"
                },
                "expected": {},
                "actual": {},
                "rule_id": {
                  "type": "string"
                },
                "hint": {
                  "type": "string"
                },
                "connecting": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "severity",
                "code",
                "target",
                "message"
              ]
            }
