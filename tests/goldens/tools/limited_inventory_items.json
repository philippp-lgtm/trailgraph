  "tools": [
    {
      "name": "run_items_by_condition",
      "kind": "function",
      "entry": "items_by_condition",
      "description": "Items in a given physical condition.\n\nUse when: Which items are worn or damaged; a list of items by condition.\n\nExamples:\n- Which items are damaged? Arguments: {\"condition\": \"damaged\"}",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "condition": {
            "type": "string",
            "enum": [
              "new",
              "good",
              "worn",
              "damaged"
            ],
            "description": "The condition to look for. Values: new - Unused.; good - Used, fully functional.; worn - Visible wear, still functional.; damaged - Not safe or not able to be used.."
          },
          "_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Rows per page, at most 500.",
            "default": 50
          },
          "_offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Rows to skip; the next page starts at page.next_offset.",
            "default": 0
          }
        },
        "required": [
          "condition"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "hash"
            ]
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Name of the item."
                },
                "condition": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "new",
                        "good",
                        "worn",
                        "damaged"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The condition, as asked for."
                }
              },
              "required": [
                "item",
                "condition"
              ]
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "shown": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              },
              "truncated": {
                "type": "boolean"
              },
              "next_offset": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "total",
              "shown",
              "limit",
              "offset",
              "truncated",
              "next_offset"
            ]
          }
        },
        "required": [
          "function",
          "columns",
          "items",
          "page"
        ]
      },
      "annotations": {
        "read_only": true,
        "dry_run": false,
        "reason": null,
        "paging": "offset"
      },
